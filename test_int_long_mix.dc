int add_int(int a, int b){
  return a + b;
}

long add_long(long a, long b){
  return a + b;
}

int main(){
  int i;
  long l;
  int r1;
  long r2;
  long l2;

  i = 10;
  l = 3000000000;

  r1 = add_int(i, 20);
  if(r1 == 30){
  }
  else{
    return 1;
  }

  r2 = add_long(l, 100);
  if(r2 == 3000000100){
  }
  else{
    return 2;
  }

  l2 = i;
  if(l2 == 10){
  }
  else{
    return 3;
  }

  if(l > i){
    return 0;
  }
  return 4;
}
